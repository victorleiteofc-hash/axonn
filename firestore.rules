rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clinical profiles: readable and writable ONLY by the profile owner (Prevents BOLA / Broken Object Level Authorization)
    match /clinical_profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.data.uid == userId;
    }
    // Activity / Audit logs: writable ONLY by the authenticated user for themselves, with schema validation
    match /activity_logs/{logId} {
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'eventType', 'timestamp'])
        && request.resource.data.size() <= 8;
      allow read: if false;
      allow update, delete: if false;
    }
    // Actives compendium: NOT readable from client SDK — served exclusively via server-side REST API
    match /actives/{activeId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
